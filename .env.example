# Server

PORT=3001

NODE_ENV=development



# MongoDB — required for saving registrations & admin portal
# Local: mongodb://localhost:27017/iyc
# Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/iyc?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb://localhost:27017/iyc



# Admin portal login

ADMIN_USERNAME=admin

ADMIN_PASSWORD=change_me_to_a_strong_password

JWT_SECRET=change_me_to_a_long_random_secret



# Email — notifications sent when someone registers

ADMIN_EMAIL=indianyouthconference@gmail.com

FROM_EMAIL=indianyouthconference@gmail.com



# SMTP (Gmail example — use an App Password, not your regular password)

# https://support.google.com/accounts/answer/185833

SMTP_HOST=smtp.gmail.com

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=indianyouthconference@gmail.com

SMTP_PASS=your_gmail_app_password_here

