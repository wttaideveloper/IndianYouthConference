# Server
PORT=3001

# development | production
# Docker Compose overrides this to production automatically.
# For local dev use "development"; for local prod testing use: npm run start:prod
NODE_ENV=production

# MongoDB — required for saving registrations & admin portal
#
# Local development:
#   MONGODB_URI=mongodb://localhost:27017/iyc
#
# Production (MongoDB Atlas):
#   1. Create a free cluster at https://cloud.mongodb.com
#   2. Database Access → create a user with readWrite on the `iyc` database
#   3. Network Access → add your EC2 public IP (or 0.0.0.0/0 for testing only)
#   4. Connect → Drivers → copy the connection string and replace USER/PASSWORD
#
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/iyc?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb://localhost:27017/iyc

# Admin portal login — single user (legacy) or multi-user viewer support
ADMIN_USERNAME=clientadmin
ADMIN_PASSWORD=change_me_to_a_strong_password
JWT_SECRET=change_me_to_a_long_random_secret
# Optional: JSON array for multiple admins with roles (admin = full, viewer = read-only). Overrides ADMIN_USERNAME/PASSWORD when set.
# Example: ADMIN_USERS_JSON='[{"username":"admin","password":"strong_pass","role":"admin"},{"username":"viewer","password":"view_pass","role":"viewer"}]'
# ADMIN_USERS_JSON=

# Email — admin notified on new registration; user notified after admin verifies
ADMIN_EMAIL=info@indianyouthconference.com
FROM_EMAIL=info@indianyouthconference.com

# SMTP (Google Workspace for indianyouthconference.com)
# Use an App Password if 2FA is enabled: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@indianyouthconference.com
SMTP_PASS=your_email_password_or_app_password_here

# Admin custom email campaigns
ADMIN_EMAIL_MAX_RECIPIENTS=100
ADMIN_EMAIL_CONCURRENCY=3
ADMIN_EMAIL_RATE_PER_MINUTE=1
ADMIN_EMAIL_RATE_PER_HOUR=10
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000

# Attendee registration-access secrets
REGISTRATION_ACCESS_OTP_PEPPER=
REGISTRATION_ACCESS_TOKEN_PEPPER=

# Optional: set true for local HTTPS testing.
# Production cookies are always Secure regardless of this value.
COOKIE_SECURE=false

# Optional only when frontend and API are hosted on separate origins.
# Leave blank for Vite proxy / same-origin Docker deployment.
APP_ORIGIN=
