{
  "name": "indianyouthconference",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --env-file=.env --watch server/index.js",
    "build": "tsc -b && vite build",
